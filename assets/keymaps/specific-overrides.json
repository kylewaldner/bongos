// Put keybindings bound to a tight specific context that need to overwrite the
// base keymaps here. Only put them here if absolutely needed. In those cases
// also add a comment to the default keymaps that this binding exists here, to
// make it a little more discoverable.
//
// This is loaded after all the base keymaps (Atom, vim etc) but before the user
// keymaps, giving it the highest precedence of all the bindings set by us.
[
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-shift-a": "picker::ToggleActionsMenu",
    },
  },
  {
    "context": "(Picker && with_preview) > Editor",
    "bindings": {
      "ctrl-alt-p": "picker::TogglePreview",
      "ctrl-alt-right": "picker::SetPreviewRight",
      "ctrl-alt-down": "picker::SetPreviewBelow",
      "ctrl-alt-up": "picker::SetPreviewHidden",
    },
  },
  {
    "context": "FileFinder || (FileFinder > Picker > Editor) || (FileFinder > Picker > menu)",
    "bindings": {
      "ctrl-shift-p": "file_finder::SelectPrevious",
      "ctrl-j": "pane::SplitDown",
      "ctrl-k": "pane::SplitUp",
      "ctrl-h": "pane::SplitLeft",
      "ctrl-l": "pane::SplitRight",
    },
  },
  {
    "context": "TextFinder || (TextFinder > Picker > Editor) || (TextFinder > Picker > menu)",
    "bindings": {
      "ctrl-alt-f": "text_finder::ToProjectSearch",
      "ctrl-j": "pane::SplitDown",
      "ctrl-k": "pane::SplitUp",
      "ctrl-h": "pane::SplitLeft",
      "ctrl-l": "pane::SplitRight",
    },
  },
  // The minibuffer strip (Emacs keys). Hosts add `Minibuffer > <HostContext> > Editor` blocks
  // after these.
  {
    "context": "Minibuffer > Editor",
    "bindings": {
      "ctrl-g": "minibuffer::Cancel",
      "escape": "minibuffer::Cancel",
      "enter": "minibuffer::Confirm",
      "ctrl-j": "minibuffer::ConfirmInput",
      "ctrl-n": "minibuffer::SelectNext",
      "down": "minibuffer::SelectNext",
      "ctrl-p": "minibuffer::SelectPrev",
      "up": "minibuffer::SelectPrev",
      "alt-p": "minibuffer::HistoryPrev",
      "alt-n": "minibuffer::HistoryNext",
      "alt-x": "minibuffer::Open",
    },
  },
  {
    "context": "Minibuffer > Picker > Editor",
    "bindings": {
      "ctrl-v": "minibuffer::PageDown",
      "alt-v": "minibuffer::PageUp",
      "tab": "minibuffer::CompleteCommonPrefix",
      "alt-o": "minibuffer::Actions",
    },
  },
  // The file finder keeps its `FileFinder` context in the strip; its split keys are for the
  // centered modal, so the strip gets the Emacs keys back (splits are on `alt-o`).
  {
    "context": "Minibuffer > FileFinder > Picker > Editor",
    "bindings": {
      "ctrl-k": ["zed::Unbind", "pane::SplitUp"],
      "ctrl-h": ["zed::Unbind", "pane::SplitLeft"],
      "ctrl-l": ["zed::Unbind", "pane::SplitRight"],
    },
  },
  // An isearch session (the `Isearch` context of its prompt). Without `Minibuffer`, so the keys
  // also hold when the prompt is not routed to the strip and opens centered.
  {
    "context": "Isearch > Editor",
    "bindings": {
      "ctrl-s": "isearch::RepeatForward",
      "ctrl-r": "isearch::RepeatBackward",
      "backspace": "isearch::DelChar",
      "ctrl-g": "isearch::Abort",
      "escape": "isearch::Quit",
      "enter": "isearch::Exit",
      "ctrl-enter": "isearch::ExitOtherEnd",
      "alt-p": "isearch::RingPrevious",
      "alt-n": "isearch::RingNext",
      "ctrl-w": "isearch::YankWord",
      "ctrl-alt-y": "isearch::YankChar",
      "alt-s ctrl-e": "isearch::YankLine",
      "alt-s .": "isearch::YankSymbol",
      "ctrl-y": "isearch::YankKill",
      "ctrl-j": "isearch::QuoteNewline",
      "alt-e": "isearch::EditString",
      "alt-c": "isearch::ToggleCaseFold",
      "alt-r": "isearch::ToggleRegexp",
      "alt-s space": "isearch::ToggleLaxWhitespace",
      "alt-s alt-<": "isearch::FirstMatch",
      "alt-s alt->": "isearch::LastMatch",
      "ctrl-l": "isearch::Recenter",
      "ctrl-c ctrl-o": "isearch::Occur",
      "alt-%": "isearch::QueryReplace",
      "ctrl-alt-%": "isearch::QueryReplaceRegexp",
    },
  },
  // The kill ring browser (the `KillRing` context of its prompt). M-n and M-p move the
  // highlight instead of walking the prompt history; without `Minibuffer`, so they also hold
  // when the prompt opens centered.
  {
    "context": "KillRing > Editor",
    "bindings": {
      "alt-n": "minibuffer::SelectNext",
      "alt-p": "minibuffer::SelectPrev",
    },
  },
  {
    "context": "Minibuffer",
    "bindings": {
      "ctrl-g": "minibuffer::Cancel",
      "escape": "minibuffer::Cancel",
    },
  },
  // The query replace prompts (the `QueryReplacePrompt` context). Without `Minibuffer`, so the
  // keys also hold when the prompt opens centered. They are deeper than the Emacs `Editor` rows
  // (`alt-c`, capitalize word) and the default `ctrl-q` (quit).
  {
    "context": "QueryReplacePrompt > Editor",
    "bindings": {
      "alt-c": "query_replace::ToggleCase",
      "ctrl-q": "query_replace::QuotedInsert",
    },
  },
  // The query replace decision view (the `QueryReplace` context of the view the session opens).
  // `ctrl-g` is deeper than the strip's `Minibuffer` cancel, and `ctrl-h` is deeper than the
  // Emacs help prefix of the workspace.
  {
    "context": "QueryReplace",
    "bindings": {
      "y": "query_replace::Yes",
      "space": "query_replace::Yes",
      "n": "query_replace::No",
      "backspace": "query_replace::No",
      "!": "query_replace::All",
      ".": "query_replace::ThisAndExit",
      ",": "query_replace::ThisAndWait",
      "^": "query_replace::Previous",
      "u": "query_replace::Undo",
      "e": "query_replace::EditReplacement",
      "q": "query_replace::Exit",
      "enter": "query_replace::Exit",
      "escape": "query_replace::Exit",
      "ctrl-g": "query_replace::Abort",
      "ctrl-l": "query_replace::Recenter",
      "?": "query_replace::Help",
      "ctrl-h": "query_replace::Help",
    },
  },
  // A running replace-string or replace-regexp (the `QueryReplaceBatch` context its editor has
  // while it runs). C-g stops it; the replacements already made stay.
  {
    "context": "Editor && QueryReplaceBatch",
    "bindings": {
      "ctrl-g": "query_replace::Abort",
    },
  },
  {
    "context": "ChatList",
    "bindings": {
      "/": "chat::Filter",
      "t": "chat::ToggleAllTasks",
      "f": "chat::ForkToTask",
      "r": "chat::Rename",
      "a": "chat::Archive",
      "u": "chat::Restore",
    },
  },
  {
    "context": "WorkPanel",
    "bindings": {
      "tab": "work::ToggleRow",
      "^": "work::Up",
    },
  },
  {
    "context": "RunsPanel",
    "bindings": {
      "enter": "workflow::OpenLogs",
      "a": "workflow::Approve",
      "v": "workflow::Revise",
      "l": "workflow::OpenLogs",
    },
  },
  {
    "context": "RunView",
    "bindings": {
      "g": "workflow::ToggleGraph",
      "enter": "workflow::OpenLogs",
      "a": "workflow::Approve",
      "v": "workflow::Revise",
      "l": "workflow::OpenLogs",
    },
  },
  {
    "context": "LandingView",
    "bindings": {
      "r": "project::ResolveSplit",
    },
  },
  {
    "context": "TaskDetailView",
    "bindings": {
      "g": "task_detail::Refresh",
      "s": "task_detail::ToggleSources",
      "x": "task::RunChecks",
      "r": "task::RunCheck",
      "k": "task::CancelChecks",
      "c": "task::Complete",
    },
  },
  {
    "context": "ProposalView",
    "bindings": {
      "enter": "proposal::Descend",
      "^": "proposal::Up",
    },
  },
]

// Loaded after the VS Code leader rows (`ctrl-k b ...`). A pending `ctrl-k` chord outranks any
// single `ctrl-k` loaded before it, so every single `ctrl-k` that must still fire is bound here.
[
  {
    "context": "Terminal",
    "bindings": {
      // Forward readline's kill-line instead of holding the Workspace `ctrl-k` chords.
      "ctrl-k": ["terminal::SendKeystroke", "ctrl-k"],
      // The documented way back to the first editor pane; the Pane context binds alt-1 otherwise.
      "alt-1": ["workspace::ActivatePane", 0],
    },
  },
  {
    "context": "RecentProjects || (RecentProjects > Picker > Editor)",
    "bindings": {
      "ctrl-k": "recent_projects::ToggleActionsMenu",
    },
  },
  {
    "context": "KeymapEditor",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-k": "keymap_editor::OpenCreateKeybindingModal",
    },
  },
]

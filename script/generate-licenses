#!/usr/bin/env bash

set -euo pipefail

CARGO_ABOUT_VERSION="0.8.2"
OUTPUT_FILE="${1:-$(pwd)/assets/licenses.md}"
TEMPLATE_FILE="script/licenses/template.md.hbs"

fail_on_stderr() {
    local tmpfile=$(mktemp)
    "$@" 2> >(tee "$tmpfile" >&2)
    local rc=$?
    [ -s "$tmpfile" ] && rc=1
    rm "$tmpfile"
    return $rc
}

echo -n "" >"$OUTPUT_FILE"

{
    echo -e "# ###### THEME LICENSES ######\n"
    cat assets/themes/LICENSES

    echo -e "\n# ###### ICON LICENSES ######\n"
    cat assets/icons/LICENSES

    echo -e "\n# ###### KOTLIN QUERY LICENSES ######\n"
    echo -e "The Kotlin highlight and outline queries in crates/bongos_languages/src/kotlin are from zed-extensions/kotlin (Evren Sen).\n"
    cat crates/bongos_languages/LICENSE-KOTLIN-EXTENSION

    echo -e "\n# ###### JAVA AND TOML QUERY LICENSES ######\n"
    echo -e "The Java highlight, outline, brackets, indents, injections and overrides queries in crates/bongos_languages/src/java are from zed-extensions/java (Java Extension Contributors), licensed Apache-2.0.\n"
    cat crates/bongos_languages/LICENSE-JAVA-EXTENSION
    echo -e "\nThe TOML queries in crates/bongos_languages/src/toml are from zed-extensions/toml (Zed Industries, Inc.), licensed Apache-2.0.\n"
    cat crates/bongos_languages/LICENSE-TOML-EXTENSION

    echo -e "\n# ###### CODE LICENSES ######\n"
} >>"$OUTPUT_FILE"

if ! cargo about --version | grep "cargo-about $CARGO_ABOUT_VERSION" &>/dev/null; then
    echo "Installing cargo-about@$CARGO_ABOUT_VERSION..."
    cargo install "cargo-about@$CARGO_ABOUT_VERSION"
else
    echo "cargo-about@$CARGO_ABOUT_VERSION is already installed."
fi

echo "Generating cargo licenses"
if [ -z "${ALLOW_MISSING_LICENSES-}" ]; then FAIL_FLAG=--fail; else FAIL_FLAG=""; fi
if [ -z "${ALLOW_MISSING_LICENSES-}" ]; then WRAPPER=fail_on_stderr; else WRAPPER=""; fi
set -x
$WRAPPER cargo about generate \
    $FAIL_FLAG \
    -c script/licenses/zed-licenses.toml \
    "$TEMPLATE_FILE" >>"$OUTPUT_FILE"
set +x

# cargo-about 0.8.2 (krates 0.20) drops md-5 because its lib target is named md5, so it never matches
# oo7's `dep:md-5` feature. Its license is appended by hand; the guard fails when the locked version moves.
if ! grep -A1 '^name = "md-5"$' Cargo.lock | grep -q '^version = "0.10.6"$'; then
    echo "md-5 changed version in Cargo.lock; update script/licenses/md-5-supplement.md" >&2
    exit 1
fi
{
    echo
    cat script/licenses/md-5-supplement.md
} >>"$OUTPUT_FILE"

sed -i.bak 's/&quot;/"/g' "$OUTPUT_FILE"
sed -i.bak 's/&#x27;/'\''/g' "$OUTPUT_FILE" # The ` '\'' ` thing ends the string, appends a single quote, and re-opens the string
sed -i.bak 's/&#x3D;/=/g' "$OUTPUT_FILE"
sed -i.bak 's/&#x60;/`/g' "$OUTPUT_FILE"
sed -i.bak 's/&lt;/</g' "$OUTPUT_FILE"
sed -i.bak 's/&gt;/>/g' "$OUTPUT_FILE"

rm -rf "${OUTPUT_FILE}.bak"

echo "generate-licenses completed. See $OUTPUT_FILE"

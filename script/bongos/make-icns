#!/usr/bin/env python3
"""Writes an .icns file from PNG files, so no icns tool is needed.
usage: make-icns <out.icns> <size>=<png> ...
Sizes: 16 32 64 128 256 512 1024 (the pixel size of each PNG). Retina entries are the double sizes.
"""
import struct
import sys

# pixel size -> icns type code; every one of these holds a PNG
CODES = {
    32: b"ic11",   # 16x16 @2x
    64: b"ic12",   # 32x32 @2x
    128: b"ic07",
    256: b"ic08",
    512: b"ic09",
    1024: b"ic10",
}


def main():
    out = sys.argv[1]
    entries = []
    for arg in sys.argv[2:]:
        size, path = arg.split("=", 1)
        code = CODES.get(int(size))
        if code is None:
            sys.exit("make-icns: unsupported size %s" % size)
        data = open(path, "rb").read()
        if data[:8] != b"\x89PNG\r\n\x1a\n":
            sys.exit("make-icns: %s is not a PNG" % path)
        entries.append(code + struct.pack(">I", len(data) + 8) + data)
    body = b"".join(entries)
    open(out, "wb").write(b"icns" + struct.pack(">I", len(body) + 8) + body)


main()

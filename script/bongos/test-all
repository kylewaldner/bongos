#!/usr/bin/env bash
# The full test suite with cargo-nextest: every library, binary and integration test of the
# workspace, in one build, one process per test. A hung test is killed after 10 minutes and reported
# as TIMEOUT (.config/nextest.toml). Doctests are not run (nextest does not run them).
#   test-all [crate...]   named crates only, replacing --workspace; for a cheap trial of the script
#   BONGOS_TEST_FILTER=s  only tests whose name contains s (a positional nextest filter)
#   BONGOS_TEST_NO_NET=1  cargo runs offline (CARGO_NET_OFFLINE=true)
# The extension_host dev-extension test reads the wasi-sdk from the repository's own target/wasi-sdk.
# This script links that path to $BONGOS_WORKSPACE/wasi-sdk/<version> (fetch-wasi-sdk downloads it
# once), so the test needs no network.
# Prints the nextest totals; the full output is in the log.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/env.sh"
. "$here/lib.sh"
cd "$BONGOS_ROOT"
log_init test-all

if ! cargo nextest --version >/dev/null 2>&1; then
  echo "bongos: cargo-nextest is missing; install it with: cargo install cargo-nextest --locked (or the distro package)" >&2
  exit 1
fi

# nextest's final line: "Summary [ 12.3s] 100 tests run: 99 passed (1 slow), 1 failed, 4 skipped".
# Timeouts show in it as "N timed out" (and in the failures as TIMEOUT).
summary_hook() {
  local line
  line=$(grep -E '^ *Summary \[' "$LOG" | tail -n1 || true)
  if [ -z "$line" ]; then
    SUMMARY="no nextest summary"
    return 0
  fi
  SUMMARY=$(awk '{
    p = f = s = t = 0
    if (match($0, /[0-9]+ passed/)) p = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ failed/)) f = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ skipped/)) s = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ timed out/)) t = substr($0, RSTART, RLENGTH) + 0
    printf "passed=%d failed=%d skipped=%d timed_out=%d", p, f, s, t
  }' <<<"$line")
}

require_space
ensure_wasi_sdk

scope=(--workspace)
if [ "$#" -gt 0 ]; then
  scope=()
  for c in "$@"; do scope+=(-p "$c"); done
fi

# Offline cargo, so a missing dependency fails the run instead of fetching it.
if [ "${BONGOS_TEST_NO_NET:-}" = 1 ]; then
  export CARGO_NET_OFFLINE=true
fi

filter=()
[ -n "${BONGOS_TEST_FILTER:-}" ] && filter=("$BONGOS_TEST_FILTER")

cargo_limited nextest run "${scope[@]}" "${filter[@]}" --lib --bins --tests --locked --no-fail-fast --color never

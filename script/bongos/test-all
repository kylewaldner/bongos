#!/usr/bin/env bash
# The full test suite with cargo-nextest: every library, binary and integration test of the
# workspace, in one build, one process per test. A hung test is killed after 10 minutes and reported
# as TIMEOUT (.config/nextest.toml). Doctests are not run (nextest does not run them).
#   test-all [crate...]   named crates only, replacing --workspace; for a cheap trial of the script
#   BONGOS_TEST_FILTER=s  only tests whose name contains s (a positional nextest filter)
#   BONGOS_TEST_NO_NET=1  cargo runs offline (CARGO_NET_OFFLINE=true)
#   BONGOS_TEST_PARTITION=K/N  run only slice K of N of the tests (nextest --partition hash:K/N)
#   BONGOS_NEXTEST_PROFILE=p   nextest profile (default gate: everything except the timing tests; perf runs only them)
# The extension_host dev-extension test (test_extension_store_with_test_extension) expects a wasi-sdk
# in the repository's own target/wasi-sdk and tries to download one when it is missing; in a fresh
# worktree that failed on 2026-11-07 (the test's HTTP client is a fake), so a failure of that one
# test alone is the environment, not the change under test, until the dropped error is logged.
# Prints the nextest totals; the full output is in the log.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/env.sh"
. "$here/lib.sh"
cd "$BONGOS_ROOT"
log_init test-all
say_unified_features

if ! cargo nextest --version >/dev/null 2>&1; then
  echo "bongos: cargo-nextest is missing; install it with: cargo install cargo-nextest --locked (or the distro package)" >&2
  exit 1
fi

# nextest's final line: "Summary [ 12.3s] 100 tests run: 99 passed (1 slow), 1 failed, 4 skipped".
# Timeouts show in it as "N timed out" (and in the failures as TIMEOUT). A test that failed and then
# passed on a retry is counted in "passed" and also shown as "N flaky" in the parentheses; it is
# printed as flaky=N, last.
summary_hook() {
  local line
  line=$(grep -E '^ *Summary \[' "$LOG" | tail -n1 || true)
  if [ -z "$line" ]; then
    SUMMARY="no nextest summary"
    return 0
  fi
  SUMMARY=$(awk '{
    p = f = s = t = k = 0
    if (match($0, /[0-9]+ passed/)) p = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ failed/)) f = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ skipped/)) s = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ timed out/)) t = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ flaky/)) k = substr($0, RSTART, RLENGTH) + 0
    printf "passed=%d failed=%d skipped=%d timed_out=%d flaky=%d", p, f, s, t, k
  }' <<<"$line")
}

require_space

scope=(--workspace)
if [ "$#" -gt 0 ]; then
  scope=()
  for c in "$@"; do scope+=(-p "$c"); done
fi

# Offline cargo, so a missing dependency fails the run instead of fetching it.
if [ "${BONGOS_TEST_NO_NET:-}" = 1 ]; then
  export CARGO_NET_OFFLINE=true
fi

filter=()
[ -n "${BONGOS_TEST_FILTER:-}" ] && filter=("$BONGOS_TEST_FILTER")

# BONGOS_TEST_PARTITION=K/N runs only slice K of N (nextest --partition hash:K/N), so a long run can be
# split across several calls; every slice together is the whole suite.
partition=()
if [ -n "${BONGOS_TEST_PARTITION:-}" ]; then
  if [[ "$BONGOS_TEST_PARTITION" =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] && [ "${BASH_REMATCH[1]}" -le "${BASH_REMATCH[2]}" ]; then
    partition=(--partition "hash:$BONGOS_TEST_PARTITION")
  else
    echo "bongos: BONGOS_TEST_PARTITION must be K/N with 1 <= K <= N (for example 1/2), got '$BONGOS_TEST_PARTITION'" >&2
    exit 1
  fi
fi

cargo_limited nextest run "${scope[@]}" "${filter[@]}" ${partition[@]+"${partition[@]}"} --profile "${BONGOS_NEXTEST_PROFILE:-gate}" --lib --bins --tests --locked --no-fail-fast --color never

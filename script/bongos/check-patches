#!/usr/bin/env bash
# Compares the files that differ from upstream with UPSTREAM-PATCHES.md, both ways.
# Every changed upstream file needs a row, and every row must match a changed file. New files must be
# under crates/bongos_*, script/bongos/, plans/, .claude/, or be one of our root files.
# Compares the working tree (tracked changes and untracked files), so it works before a commit.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/env.sh"
. "$here/lib.sh"
cd "$BONGOS_ROOT"

base=$(upstream_commit)
list="$BONGOS_ROOT/UPSTREAM-PATCHES.md"
[ -f "$list" ] || { echo "bongos: UPSTREAM-PATCHES.md is missing" >&2; exit 1; }
git cat-file -e "$base^{commit}" 2>/dev/null || { echo "bongos: upstream commit $base is not in this clone" >&2; exit 1; }

# status<TAB>path for tracked changes against upstream, then untracked files as added.
changes=$({ git diff --name-status --no-renames "$base"; git ls-files --others --exclude-standard | sed 's/^/A\t/'; })

CHANGES="$changes" python3 -I - "$list" <<'PY'
import os, re, sys

OUR_ROOT_FILES = {"UPSTREAM", "UPSTREAM-PATCHES.md", "DISCOVERY.md", "EMACS-FEATURES.md"}
OUR_PREFIXES = ("script/bongos/", "plans/", ".claude/")

def expand(p):
    m = re.search(r"\{([^{}]*)\}", p)
    if not m:
        return [p]
    return [r for alt in m.group(1).split(",") for r in expand(p[:m.start()] + alt + p[m.end():])]

def matches(pat, path):
    if pat.endswith("/**"):
        return path.startswith(pat[:-2])
    return path == pat

patterns = []
for line in open(sys.argv[1]):
    if not line.startswith("|"):
        continue
    first = line.split("|")[1]
    for tok in re.findall(r"`([^`]+)`", first):
        patterns.extend(expand(tok))

changes = [l.split("\t", 1) for l in os.environ["CHANGES"].splitlines() if l]
errors = []
hit = set()
for status, path in changes:
    found = [p for p in patterns if matches(p, path)]
    hit.update(found)
    if found:
        continue
    ours = (status == "A") and (
        path in OUR_ROOT_FILES or path.startswith(OUR_PREFIXES) or path.startswith("crates/bongos_"))
    if not ours:
        errors.append(f"not in UPSTREAM-PATCHES.md: {status} {path}")
for p in patterns:
    if p not in hit:
        errors.append(f"row matches no changed file: {p}")
if errors:
    print("\n".join("bongos: " + e for e in errors), file=sys.stderr)
    sys.exit(1)
print(f"check-patches: ok ({len(changes)} changed paths, {len(patterns)} rows)")
PY

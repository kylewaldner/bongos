#!/usr/bin/env bash
# Gate 4: run the real app in Xvfb with lavapipe, in a network namespace whose only exit is a
# logging proxy. `smoke [feature]` also runs scenarios/<feature>.sh.
# BONGOS_REAL_GPU=1 uses the real GPU instead of lavapipe; the Selected GPU line is printed either way.
# BONGOS_STOCK=1 runs the stock binary: no version or bongos-name checks, and Zed hosts are required.
# The terminal gets one line per step, the screenshot path, the proxy summary (request count and
# distinct hosts) and a last summary line; everything else is in the log (script/bongos/tail-log smoke).
set -euo pipefail
here="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/env.sh"
. "$here/lib.sh"

if [ -z "${BONGOS_IN_SANDBOX:-}" ]; then
  # Masking the real home means no bug here can touch real config. The workspace and the repository
  # are bound back when they live under it (a desktop with everything in $HOME). --unshare-pid means
  # that killing this script takes Xvfb, the proxy and the app with it, trap or no trap.
  mask=(--tmpfs "$HOME")
  for p in "$BONGOS_WORKSPACE" "$BONGOS_ROOT"; do
    case "$p/" in "$HOME"/*) mask+=(--bind "$p" "$p") ;; esac
  done
  # Fail before the sandbox if the software Vulkan driver is missing.
  [ "${BONGOS_REAL_GPU:-}" = 1 ] || find_lvp_icd >/dev/null
  command -v bwrap >/dev/null || { echo "bongos: bwrap is not installed; run script/bongos/setup-machine" >&2; exit 1; }
  exec bwrap --dev-bind / / --tmpfs /tmp --proc /proc "${mask[@]}" --chdir "$BONGOS_ROOT" \
    --unshare-net --unshare-pid --new-session --die-with-parent \
    --setenv BONGOS_IN_SANDBOX 1 -- "$here/smoke" "$@"
fi

if [ "$(wc -l </proc/net/route)" -gt 1 ]; then
  echo "bongos: the sandbox has a network route; refusing to run" >&2
  exit 1
fi

feature=${1:-}
stock=${BONGOS_STOCK:-}
RUN="$BONGOS_WORKSPACE/scratch/smoke/$(date +%Y%m%d-%H%M%S)${stock:+-stock}"
mkdir -p "$RUN"
log_init smoke
sandbox_env

APP_PID="" PROXY_PID="" XVFB_PID=""
cleanup() {
  local rc=$? pid
  trap - EXIT
  if [ "$rc" != 0 ] && [ -n "$XVFB_PID" ]; then
    shot failure 2>/dev/null || true
  fi
  for pid in "$APP_PID" "$PROXY_PID" "$XVFB_PID"; do
    if [ -n "$pid" ]; then
      kill "$pid" 2>/dev/null || true
    fi
  done
  wait 2>/dev/null || true
  if [ "$rc" != 0 ]; then
    echo "bongos: smoke FAILED (exit $rc); output in $RUN"
    [ -f "$RUN/failure.png" ] && echo "smoke: failure screenshot $RUN/failure.png" >&3
    SUMMARY="run: $RUN"
  fi
  finish_report "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

step() { say "smoke: $*"; }

if [ ! -x "$BONGOS_BIN" ]; then
  echo "bongos: no binary at $BONGOS_BIN" >&2
  exit 1
fi

if [ -z "$stock" ]; then
  step "1 version"
  version=$("$BONGOS_BIN" --version 2>&1 || true)
  tag=$(origin_tag)
  if ! grep -qE '^bongos [0-9.]+ \(forked from Zed v[0-9.]+, [0-9a-f]{7}\)$' <<<"$version" ||
    ! grep -qF "forked from Zed ${tag:-no tag in ORIGIN.md}," <<<"$version"; then
    echo "bongos: bad version line: $version" >&2
    exit 1
  fi
fi

cp -r "$BONGOS_ROOT/script/bongos/fixtures/hello" "$RUN/project"
git -C "$RUN/project" init -q
seed_settings
start_display
start_proxy

step "2 launch"
launch "$RUN/project"
wait_for_window
wait_for_title "$BONGOS_TITLE"
assert_file "$HOME/$BONGOS_LOG_PATH" 'Selected GPU'
say "smoke: $(grep -h 'Selected GPU' "$HOME/$BONGOS_LOG_PATH" | head -n1 | cut -c1-200)"
poll 60 "a rendered frame" ui_rendered
wait_for_settled

step "3 file finder"
act keys ctrl+p
act type_text Main.kt
keys Return
wait_for_title 'Main\.kt'

step "4 edit and save"
keys ctrl+End
type_text '// smoke'
keys ctrl+s
assert_file "$RUN/project/Main.kt" '// smoke'

step "5 split"
act keys ctrl+backslash
shot split

step "6 terminal"
act keys ctrl+grave
wait_for_terminal
type_text 'pwd > terminal-ok.txt'
keys Return
assert_file "$RUN/project/terminal-ok.txt" "^$RUN/project\$"

step "7 quit"
if [ -n "$stock" ]; then
  assert_zed_hosts
fi
quit_app
if [ -z "$stock" ]; then
  assert_file "$HOME/$BONGOS_CONFIG_PATH/settings.json"
  assert_file "$HOME/$BONGOS_CONFIG_PATH/keymap.json"
  zed_paths=$(cd "$HOME" && find . -ipath '*zed*')
  if [ -n "$zed_paths" ]; then
    echo "bongos: zed paths in the throwaway home: $zed_paths" >&2
    exit 1
  fi
fi

step "8 restore"
launch
wait_for_window
wait_for_title 'Main\.kt'
poll 60 "a rendered frame" ui_rendered
wait_for_settled
shot final
quit_app

step "9 hosts"
if [ -z "$stock" ]; then
  assert_no_zed_hosts
  assert_no_marketplace_host
fi
proxy_hosts=$(awk '{print $2}' "$RUN/proxy.log" | sort -u | xargs)
proxy_count=$(wc -l <"$RUN/proxy.log")
say "smoke: proxy: $proxy_count requests; hosts: ${proxy_hosts:-none}"
sort -u "$RUN/proxy.log" | sed 's/^/bongos: proxy: /'

if [ -n "$feature" ]; then
  . "$BONGOS_ROOT/script/bongos/scenarios/$feature.sh"
fi

say "smoke: screenshot $RUN/final.png"
SUMMARY="proxy=${proxy_count}req/$(wc -w <<<"$proxy_hosts")hosts"

#!/usr/bin/env bash
# Gate 3: unit and UI tests for the crates changed on this branch, run with cargo-nextest: one
# process per test, and a hung test is killed after the per-test timeout in .config/nextest.toml (the
# same one test-all uses) and reported as TIMEOUT. Doctests are not run.
# Prints pass and fail counts, and the name and failure text of each failing test; the full output
# is in the log.
#   test [crate...]       named crates select which tests run; BONGOS_TEST_FILTER=<name> passes a name filter, for the slow zed binary
#   BONGOS_TEST_NO_NET=1  cargo runs offline (CARGO_NET_OFFLINE=true)
#   BONGOS_TEST_PARTITION=K/N  run only slice K of N of the tests (nextest --partition hash:K/N)
# Unless BONGOS_UNIFIED_FEATURES=1, every distinct set of -p flags makes cargo unify features
# differently and build another full set of dependency artifacts, so the -p set is always the
# branch's changed crates (sorted), and named crates only select tests through a nextest filterset
# (package(=name)). A named crate that is not changed on the branch is added to the -p set, which
# builds a different set; a line says so.
# Narrow a run with crate names or BONGOS_TEST_FILTER (an intersection with the named crates). The
# whole suite is script/bongos/test-all.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/env.sh"
. "$here/lib.sh"
cd "$BONGOS_ROOT"
log_init test
say_unified_features

if ! cargo nextest --version >/dev/null 2>&1; then
  echo "bongos: cargo-nextest is missing; install it with: cargo install cargo-nextest --locked (or the distro package)" >&2
  exit 1
fi

# nextest's final line: "Summary [ 12.3s] 100 tests run: 99 passed (1 slow), 1 failed, 4 skipped".
# A timeout counts as a failure (it shows as "N timed out" there and as TIMEOUT in the failures).
# Skipped tests are reported as ignored.
summary_hook() {
  local line
  line=$(grep -E '^ *Summary \[' "$LOG" | tail -n1 || true)
  if [ -z "$line" ]; then
    SUMMARY="no nextest summary"
    return 0
  fi
  SUMMARY=$(awk '{
    p = f = s = t = 0
    if (match($0, /[0-9]+ passed/)) p = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ failed/)) f = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ skipped/)) s = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ timed out/)) t = substr($0, RSTART, RLENGTH) + 0
    printf "passed=%d failed=%d ignored=%d", p, f + t, s
  }' <<<"$line")
}

# The -p set is the branch's changed crates, plus any named crate that is not among them. Named
# crates select tests through a filterset, so naming a changed crate never changes what is built.
changed=()
while IFS= read -r c; do
  [ -n "$c" ] && changed+=("$c")
done < <(changed_crates)
named=()
[ "$#" -gt 0 ] && named=("$@")
extra=()
for c in ${named[@]+"${named[@]}"}; do
  found=0
  for d in ${changed[@]+"${changed[@]}"}; do [ "$c" = "$d" ] && found=1; done
  [ "$found" -eq 0 ] && extra+=("$c")
done
crates=()
while IFS= read -r c; do
  [ -n "$c" ] && crates+=(-p "$c")
done < <(printf '%s\n' ${changed[@]+"${changed[@]}"} ${extra[@]+"${extra[@]}"} | sort -u)
if [ "${#crates[@]}" -eq 0 ]; then
  echo "no crates named and none changed on this branch; nothing to run"
  SUMMARY="nothing to run"
  summary_hook() { :; }
  exit 0
fi
if [ "${#extra[@]}" -gt 0 ]; then
  echo "bongos: not changed on this branch, added to the build (a different package set; cargo rebuilds unless unified features are on): $(printf '%s\n' "${extra[@]}" | sort -u | tr '\n' ' ')"
fi
# nextest intersects -E with the positional name filter below, so BONGOS_TEST_FILTER still narrows
# within the named crates.
selection=()
if [ "${#named[@]}" -gt 0 ]; then
  expression=""
  while IFS= read -r c; do
    expression="${expression:+$expression | }package(=$c)"
  done < <(printf '%s\n' "${named[@]}" | sort -u)
  selection=(-E "$expression")
fi

require_space
# BONGOS_TEST_NO_NET=1: cargo runs in a network namespace with loopback only, so a test that reaches
# out fails. The real filesystem stays writable, so tests must use temp directories.
[ "${BONGOS_TEST_NO_NET:-}" = 1 ] && export BONGOS_CARGO_NO_NET=1
filter=()
[ -n "${BONGOS_TEST_FILTER:-}" ] && filter=("$BONGOS_TEST_FILTER")

# BONGOS_TEST_PARTITION=K/N runs only slice K of N (nextest --partition hash:K/N), so a long run can be
# split across several calls; every slice together is the whole suite.
partition=()
if [ -n "${BONGOS_TEST_PARTITION:-}" ]; then
  if [[ "$BONGOS_TEST_PARTITION" =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] && [ "${BASH_REMATCH[1]}" -le "${BASH_REMATCH[2]}" ]; then
    partition=(--partition "hash:$BONGOS_TEST_PARTITION")
  else
    echo "bongos: BONGOS_TEST_PARTITION must be K/N with 1 <= K <= N (for example 1/2), got '$BONGOS_TEST_PARTITION'" >&2
    exit 1
  fi
fi

# Offline cargo, so a missing dependency fails the run instead of fetching it.
if [ "${BONGOS_TEST_NO_NET:-}" = 1 ]; then
  export CARGO_NET_OFFLINE=true
fi

# No --lib: a package without a library target (the bongos binary crate) makes cargo fail. --tests
# still runs every library's unit tests.
cargo_limited nextest run "${crates[@]}" ${selection[@]+"${selection[@]}"} ${filter[@]+"${filter[@]}"} ${partition[@]+"${partition[@]}"} --bins --tests --locked --no-fail-fast --no-tests=pass --color never

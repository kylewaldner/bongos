#!/usr/bin/env bash
# Gate 3: unit and UI tests for the named crates, else the crates changed on this branch, run with
# cargo-nextest: one process per test, and a hung test is killed after the per-test timeout in
# .config/nextest.toml (the same one test-all uses) and reported as TIMEOUT. Doctests are not run.
# Prints pass and fail counts, and the name and failure text of each failing test; the full output
# is in the log.
#   test [crate...]       BONGOS_TEST_FILTER=<name> passes a name filter, for the slow zed binary
#   BONGOS_TEST_NO_NET=1  cargo runs offline (CARGO_NET_OFFLINE=true)
# Prefer running it with no crate names, which tests the crates changed on this branch, and narrow
# the run with BONGOS_TEST_FILTER. Every distinct set of -p flags makes cargo unify features
# differently and build another full set of dependency artifacts, so name crates only when the
# branch's set is wrong. The whole suite is script/bongos/test-all.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/env.sh"
. "$here/lib.sh"
cd "$BONGOS_ROOT"
log_init test

if ! cargo nextest --version >/dev/null 2>&1; then
  echo "bongos: cargo-nextest is missing; install it with: cargo install cargo-nextest --locked (or the distro package)" >&2
  exit 1
fi

# nextest's final line: "Summary [ 12.3s] 100 tests run: 99 passed (1 slow), 1 failed, 4 skipped".
# A timeout counts as a failure (it shows as "N timed out" there and as TIMEOUT in the failures).
# Skipped tests are reported as ignored.
summary_hook() {
  local line
  line=$(grep -E '^ *Summary \[' "$LOG" | tail -n1 || true)
  if [ -z "$line" ]; then
    SUMMARY="no nextest summary"
    return 0
  fi
  SUMMARY=$(awk '{
    p = f = s = t = 0
    if (match($0, /[0-9]+ passed/)) p = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ failed/)) f = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ skipped/)) s = substr($0, RSTART, RLENGTH) + 0
    if (match($0, /[0-9]+ timed out/)) t = substr($0, RSTART, RLENGTH) + 0
    printf "passed=%d failed=%d ignored=%d", p, f + t, s
  }' <<<"$line")
}

crates=()
if [ "$#" -gt 0 ]; then
  for c in "$@"; do crates+=(-p "$c"); done
else
  while IFS= read -r c; do
    [ -n "$c" ] && crates+=(-p "$c")
  done < <(changed_crates)
fi
if [ "${#crates[@]}" -eq 0 ]; then
  echo "no crates named and none changed on this branch; nothing to run"
  SUMMARY="nothing to run"
  summary_hook() { :; }
  exit 0
fi

require_space
filter=()
[ -n "${BONGOS_TEST_FILTER:-}" ] && filter=("$BONGOS_TEST_FILTER")

# Offline cargo, so a missing dependency fails the run instead of fetching it.
if [ "${BONGOS_TEST_NO_NET:-}" = 1 ]; then
  export CARGO_NET_OFFLINE=true
fi

cargo_limited nextest run "${crates[@]}" ${filter[@]+"${filter[@]}"} --lib --bins --tests --locked --no-fail-fast --no-tests=pass --color never

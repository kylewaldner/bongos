#!/usr/bin/env bash
# Gate 3: unit and UI tests for the named crates, else the crates changed on this branch.
# Prints pass and fail counts, and the name and failure text of each failing test; the full output
# is in the log.
#   test [crate...]       BONGOS_TEST_FILTER=<name> passes a name filter, for the slow zed binary
# Prefer running it with no crate names, which tests the crates changed on this branch, and narrow
# the run with BONGOS_TEST_FILTER. Every distinct set of -p flags makes cargo unify features
# differently and build another full set of dependency artifacts, so name crates only when the
# branch's set is wrong. The whole suite is script/bongos/test-all.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/env.sh"
. "$here/lib.sh"
cd "$BONGOS_ROOT"
log_init test

# Counts over every cargo test run so far; the run that failed is included.
summary_hook() {
  local counts
  counts=$(awk '/^test result:/ {for (i = 1; i < NF; i++) {if ($(i+1) ~ /^passed/) p += $i; if ($(i+1) ~ /^failed/) f += $i; if ($(i+1) ~ /^ignored/) g += $i}}
    END {printf "passed=%d failed=%d ignored=%d", p, f, g}' "$LOG")
  SUMMARY="$counts"
}

crates=()
if [ "$#" -gt 0 ]; then
  for c in "$@"; do crates+=(-p "$c"); done
else
  while IFS= read -r c; do
    [ -n "$c" ] && crates+=(-p "$c")
  done < <(changed_crates)
fi
if [ "${#crates[@]}" -eq 0 ]; then
  echo "no crates named and none changed on this branch; nothing to run"
  SUMMARY="nothing to run"
  summary_hook() { :; }
  exit 0
fi

require_space
# BONGOS_TEST_NO_NET=1: cargo runs in a network namespace with loopback only, so a test that reaches
# out fails. The real filesystem stays writable, so tests must use temp directories.
[ "${BONGOS_TEST_NO_NET:-}" = 1 ] && export BONGOS_CARGO_NO_NET=1
filter=()
[ -n "${BONGOS_TEST_FILTER:-}" ] && filter=("$BONGOS_TEST_FILTER")

# A package with only a binary, such as zed, has no library: --lib would fail with "no library
# targets". Split the packages and run the binary-only ones with --bins --tests.
meta=$(cat "$(cargo_meta_file)")
libs=() bins=()
for ((i = 1; i < ${#crates[@]}; i += 2)); do
  name=${crates[i]}
  if printf '%s' "$meta" | python3 -I -c '
import json, sys
m = json.load(sys.stdin)
for p in m["packages"]:
    if p["name"] == sys.argv[1]:
        sys.exit(0 if any(k in ("lib", "rlib", "dylib", "cdylib", "staticlib", "proc-macro")
                          for t in p["targets"] for k in t["kind"]) else 1)
sys.exit(2)
' "$name"; then
    libs+=(-p "$name")
  else
    rc=$?
    if [ "$rc" = 2 ]; then echo "bongos: no package named $name"; exit 1; fi
    bins+=(-p "$name")
  fi
done
if [ "${#libs[@]}" -gt 0 ]; then
  cargo_limited test -q --color never "${libs[@]}" --lib --bins --tests --locked ${filter[@]+"${filter[@]}"}
fi
if [ "${#bins[@]}" -gt 0 ]; then
  cargo_limited test -q --color never "${bins[@]}" --bins --tests --locked ${filter[@]+"${filter[@]}"}
fi

#!/usr/bin/env bash
# Gate 1: format (changed Rust files only), clippy on changed crates, hosts, licenses, .github holds only workflows/release.yml, no webrtc.
# One line per check; the failing part of the output only for a check that fails. Full output is in
# the log (script/bongos/tail-log check).
#   BONGOS_FMT_ALL=1 checks the whole workspace with cargo fmt --all instead of the changed files.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/env.sh"
. "$here/lib.sh"
cd "$BONGOS_ROOT"
log_init check
say_unified_features
LOG_NO_EXCERPT=1  # run_check prints the failing part of the check that failed

# The tree rule below (run with unified features off, so it sees only what the app enables) is on by default since step 22, when webrtc and livekit left the build.
# BONGOS_CHECK_NO_WEBRTC=0 turns it off.
BONGOS_CHECK_NO_WEBRTC=${BONGOS_CHECK_NO_WEBRTC:-1}

# rustfmt on the files changed on this branch (working tree against the merge base, plus untracked
# files): `cargo fmt --all` spends 20 to 50 s formatting the whole workspace to find nothing.
if [ "${BONGOS_FMT_ALL:-}" = 1 ]; then
  run_check fmt cargo fmt --all -- --check
else
  fmt_files=()
  while IFS= read -r f; do
    [ -f "$f" ] && fmt_files+=("$f")
  done < <({
    git diff --name-only --diff-filter=ACMR "$(branch_base)" -- '*.rs'
    git ls-files --others --exclude-standard -- '*.rs'
  } | sort -u)
  if [ "${#fmt_files[@]}" -gt 0 ]; then
    run_check fmt rustfmt --check "${fmt_files[@]}"
  else
    say "check: fmt skipped, no changed Rust files"
  fi
fi

crates=()
while IFS= read -r c; do
  [ -n "$c" ] && crates+=(-p "$c")
done < <(changed_crates)
if [ "${#crates[@]}" -gt 0 ]; then
  require_space
  run_check "clippy ${crates[*]}" cargo_limited clippy "${crates[@]}" --all-targets --locked --color never -- --deny warnings
else
  say "check: clippy skipped, no changed crates"
fi

run_check hosts "$here/check-hosts"

run_check strings "$here/check-strings"

run_check licenses "$BONGOS_ROOT/script/check-licenses"

run_check license-fields "$here/check-license-fields"

run_check notice "$here/check-notice"

run_check icons "$here/check-icons"

no_github() {
  # Zed's own workflows stay out; the release workflow is the one tracked path allowed under .github/.
  local bad
  bad=$(git ls-files .github | grep -vx '.github/workflows/release.yml' || true)
  if [ -n "$bad" ]; then
    echo "bongos: .github may hold only workflows/release.yml; upstream workflows must not run here"
    echo "$bad"
    return 1
  fi
}
run_check ".github allowlist" no_github

no_webrtc() {
  local tree
  tree=$(cargo_plain cargo tree -p bongos --target all -e normal,build --locked) || {
    echo "bongos: cargo tree failed"
    return 1
  }
  if grep -E 'webrtc|livekit|zed-scap|screencapturekit' <<<"$tree"; then
    echo "bongos: webrtc, livekit or screen capture is still in the bongos build"
    return 1
  fi
}
if [ "$BONGOS_CHECK_NO_WEBRTC" = 1 ]; then
  run_check "no webrtc or livekit" no_webrtc
fi

SUMMARY="all checks ok"

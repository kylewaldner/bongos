#!/usr/bin/env bash
# Gate 1: format, clippy on changed crates, hosts, licenses, no .github, no webrtc (from step 22).
# One line per check; the failing part of the output only for a check that fails. Full output is in
# the log (script/bongos/tail-log check).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/env.sh"
. "$here/lib.sh"
cd "$BONGOS_ROOT"
log_init check
LOG_NO_EXCERPT=1  # run_check prints the failing part of the check that failed

# Set to 1 in step 22, when webrtc and livekit leave the build. Until then the tree rule below is off.
BONGOS_CHECK_NO_WEBRTC=${BONGOS_CHECK_NO_WEBRTC:-0}

run_check fmt cargo fmt --all -- --check

crates=()
while IFS= read -r c; do
  [ -n "$c" ] && crates+=(-p "$c")
done < <(changed_crates)
if [ "${#crates[@]}" -gt 0 ]; then
  require_space
  run_check "clippy ${crates[*]}" cargo_limited clippy "${crates[@]}" --all-targets --locked --color never -- --deny warnings
else
  say "check: clippy skipped, no changed crates"
fi

run_check hosts "$here/check-hosts"

run_check licenses "$BONGOS_ROOT/script/check-licenses"

no_github() {
  if [ -e .github ] || [ -n "$(git ls-files .github)" ]; then
    echo "bongos: .github must not exist; upstream workflows must not run here"
    return 1
  fi
}
run_check "no .github" no_github

no_webrtc() {
  if cargo tree -p zed --edges normal,build --locked | grep -E 'webrtc|livekit'; then
    echo "bongos: webrtc or livekit is still in the zed build"
    return 1
  fi
}
if [ "$BONGOS_CHECK_NO_WEBRTC" = 1 ]; then
  run_check "no webrtc or livekit" no_webrtc
fi

SUMMARY="all checks ok"

#!/bin/sh
# Ignores SIGTERM and starts a child in a session of its own that ignores it too; the child
# writes its pid to detached.pid in the tree. Then both wait forever.
trap '' TERM
setsid sh -c 'trap "" TERM; echo $$ > detached.pid.tmp; mv detached.pid.tmp detached.pid; while :; do sleep 1; done' &
echo "started"
while :; do
    sleep 1
done

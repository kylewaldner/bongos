#!/bin/sh
# Writes where it runs to its output, one line each: its directory (symbolic links resolved),
# the tree kind, the text of marker.txt there, LANE_MARK, and its part. Copies the file
# BONGOS_CHECK_EVIDENCE names beside its result file. While the file block exists in the output
# folder (the parent of the record's folder), touches blocked there and waits until stopped.
echo "pwd=$(pwd -P)"
echo "tree=$BONGOS_CHECK_TREE"
echo "marker=$(cat marker.txt 2>/dev/null)"
echo "mark=${LANE_MARK-none}"
echo "part=$BONGOS_CHECK_PART of $BONGOS_CHECK_PARTS"
out="$(dirname "$BONGOS_CHECK_RESULT")"
if [ -n "${BONGOS_CHECK_EVIDENCE-}" ]; then
    cp "$BONGOS_CHECK_EVIDENCE" "$out/evidence-copy.json"
fi
if [ -f "$out/../block" ]; then
    touch "$out/../blocked"
    sleep 60
fi
exit 0
